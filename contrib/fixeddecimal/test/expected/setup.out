SELECT am.amname, opc.opcname
FROM pg_opclass opc
JOIN pg_am am ON am.oid = opc.opcmethod
JOIN pg_namespace nsp ON nsp.oid = opc.opcnamespace
WHERE nsp.nspname = current_schema()
  AND opc.opcname IN (
    'fixeddecimal_minmax_ops',
    'fixeddecimal_ops',
    'fixeddecimal_numeric_ops',
    'numeric_fixeddecimal_ops',
    'fixeddecimal_int4_ops',
    'int4_fixeddecimal_ops',
    'fixeddecimal_int2_ops',
    'int2_fixeddecimal_ops'
  )
ORDER BY am.amname, opc.opcname;
 amname |         opcname         
--------+--------------------------
 brin   | fixeddecimal_minmax_ops
 btree  | fixeddecimal_int2_ops
 btree  | fixeddecimal_int4_ops
 btree  | fixeddecimal_numeric_ops
 btree  | fixeddecimal_ops
 btree  | int2_fixeddecimal_ops
 btree  | int4_fixeddecimal_ops
 btree  | numeric_fixeddecimal_ops
 hash   | fixeddecimal_int2_ops
 hash   | fixeddecimal_int4_ops
 hash   | fixeddecimal_numeric_ops
 hash   | fixeddecimal_ops
 hash   | int2_fixeddecimal_ops
 hash   | int4_fixeddecimal_ops
 hash   | numeric_fixeddecimal_ops
(15 rows)
